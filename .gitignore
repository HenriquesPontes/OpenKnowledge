# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Cloudflare (credentials and local state — never commit tokens or keys)
.wrangler/
.dev.vars
.dev.vars.*
.cloudflare/
.r2/
*.toml.local

# waitlist emails
/Join waitlist/*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
